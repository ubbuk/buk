{
  "version": 4,
  "configurations": [
    {
      "name": "Emscripten (C++20 -> WASM)",
      "compilerPath": "C:/emsdk/upstream/bin/clang++.exe",
      "compilerArgs": ["--target=wasm32-unknown-emscripten", "-std=c++20"],
      "cStandard": "c17",
      "cppStandard": "c++20",
      "intelliSenseMode": "windows-clang-x64",
      "defines": ["__EMSCRIPTEN__"],
      "includePath": [
        "${workspaceFolder}/native/timeline-engine",
        "C:/emsdk/upstream/emscripten/cache/sysroot/include/c++/v1",
        "C:/emsdk/upstream/lib/clang/24/include",
        "C:/emsdk/upstream/emscripten/cache/sysroot/include/compat",
        "C:/emsdk/upstream/emscripten/cache/sysroot/include"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/native/timeline-engine",
          "C:/emsdk/upstream/emscripten/cache/sysroot/include"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ]
}
