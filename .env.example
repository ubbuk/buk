# --- Required -------------------------------------------------------------
# Local dev (docker-compose.yml database on port 5433):
DATABASE_URL="postgresql://ubbuk:ubbuk@localhost:5433/ubbuk_procurement?schema=public"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
# Public URL of the app (https://<your-project>.vercel.app on Vercel).
NEXTAUTH_URL="http://localhost:3000"

# --- Vercel + Aiven PostgreSQL (see DEPLOY.md) -----------------------------
# Aiven requires TLS. Use the connection string from the Aiven console and append:
#   ?sslmode=require&connection_limit=1&pool_timeout=20
# (connection_limit=1 because every serverless instance opens its own pool; use
# Aiven's connection-pooling URL for the app if you have many concurrent users).
# DATABASE_URL="postgres://avnadmin:<password>@<host>.aivencloud.com:<port>/defaultdb?sslmode=require&connection_limit=1&pool_timeout=20"

# --- Attachments ------------------------------------------------------------
# "local" (default) writes to ./.storage -- fine for dev/staging/self-hosting, but
# NOT on Vercel (the disk is read-only/ephemeral). Use "s3" there with any
# S3-compatible PRIVATE bucket (AWS S3, Cloudflare R2, ...).
# STORAGE_DRIVER="s3"
# S3_BUCKET="ubbuk-erp-attachments"
# S3_REGION="auto"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"   # omit for AWS S3
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"
# S3_PREFIX="attachments/"

# --- Login rate limiting (lib/login-throttle.ts, lib/client-ip.ts) ------------
# Which proxy in front of the app may be believed about the client address. X-Forwarded-For
# is just a header anyone can send, so it is ignored unless this says otherwise:
#   unset            "vercel" on Vercel, otherwise no header is trusted (limits by account only)
#   vercel           Vercel sets the address headers itself
#   hops:N           N reverse proxies of yours (nginx, a load balancer) append to X-Forwarded-For;
#                    the client is the Nth entry from the RIGHT (hops:1 = one proxy, e.g. nginx)
#   none             never trust any header
# TRUSTED_PROXY="hops:1"

# --- 1С ERP integration (lib/onec, `npm run sync:1c`) ---------------------------
# Never commit real values: put them in .env only.
ONEC_BASE_URL="http://<1c-host>/<infobase>"
ONEC_USER=""
ONEC_PASSWORD=""
# 1С answers slowly (cash ~30 s, sales ~1 min per month): 5 minutes
ONEC_TIMEOUT_MS="300000"
# Vercel дээр (VERCEL=1) анхдагч нь 60000 мс × 1 оролдлого, тохируулсан ч 60000-аас хэтрэхгүй (функцийн maxDuration 60 сек).

# --- 1С data hub: external read-only API (/api/v1/onec/*, see README_HUB.md) -----
# Bearer key for the company dashboard. At least 32 characters; with it unset or shorter the endpoints refuse everyone.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# On Vercel set it in Project Settings -> Environment Variables (Production), never in the code.
ONEC_HUB_API_KEY=""

# --- 1С OData хөтөч (/onec, lib/onec-odata) — ЗӨВХӨН УНШИХ ----------------------------
# Never commit real values: put them in .env only. Нэвтрэлт зөвхөн сервер дээр уншигдана, хөтөч рүү хэзээ ч явахгүй.
ONEC_ODATA_BASE_URL="http://<1c-host>/<infobase>/odata/standard.odata"
ONEC_ODATA_USER=""
ONEC_ODATA_PASSWORD=""
# ЗААВАЛ: хэн ч харах ёсгүй объектууд (сертификат, цахим гарын үсэг, имэйлийн бүртгэл). Таслалаар тусгаарлана; бичлэг
# бүр объектын нэрэнд (том жижиг үсэг үл ялгах) агуулагдвал тэр объектыг хэн ч (ADMIN ч) харахгүй. Хоосон бол хөтөч ажиллахгүй.
# Санал болгох жагсаалтыг `npm run onec:objects` (1С-ийн $metadata-аас) гаргана; та батлаад энд бичнэ.
ONEC_ODATA_DENY=""
# ЗААВАЛ: цалин, ажилтан, хувь хүний объектууд. DENY шиг substring жагсаалт, гэхдээ эдгээрийг зөвхөн User.canViewPayroll
# (Админ хуудсанд «Цалин харах») олгосон хүн харна: дүрээс үл хамаарна, чагтгүй ADMIN ч харахгүй. Хоосон бол хөтөч ажиллахгүй.
# DENY-д тохирвол DENY давамгайлна. Одоогийн DENY-г хуваах санал: `npm run onec:objects -- --split`.
ONEC_ODATA_PAYROLL=""
# Няравт нээлттэй объектууд (агуулах/бараа материал): нэрэнд агуулагдах хэсгүүд, таслалаар. Хоосон бол нярав юу ч харахгүй.
ONEC_ODATA_STOREKEEPER_ALLOW=""

# --- «Шинэчлэх» товч (Vercel): хүнд татаалтыг GitHub Actions дээр ажиллуулна (lib/github-dispatch.ts) ------------
# Сарын (sales+pl+cash) болон авлагын агшин зургийн татаалт Vercel-ийн route дээр биш .github/workflows/sync-1c.yml дээр ажиллана.
# Токен: fine-grained personal access token, ЗӨВХӨН энэ репозиторий, ЗӨВХӨН "Actions: Read and write" эрх. Хөтөч рүү, лог руу гарахгүй.
# Тохируулаагүй бол Vercel дээр Агуулах шууд шинэчлэгдэнэ, бусад нь workflow-ийн 15 минутын хуваарийн дагуу.
# GitHub Actions secrets-д мөн: DATABASE_URL, ONEC_BASE_URL, ONEC_USER, ONEC_PASSWORD, ONEC_ODATA_BASE_URL, ONEC_ODATA_USER, ONEC_ODATA_PASSWORD
GITHUB_DISPATCH_TOKEN=""
GITHUB_REPOSITORY="<owner>/<repo>"
GITHUB_DISPATCH_REF="main"

# --- Optional ----------------------------------------------------------------
# Show the demo-account list on the login page in a production build (staging only).
# NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS="true"
# Password used by `npm run db:seed` (defaults to the public demo password).
# SEED_PASSWORD=""
# Security (docs/security-stage-2-4.md). Self-service password recovery stays OFF until an e-mail delivery channel is approved and registered.
# SELF_SERVICE_RECOVERY="off"
