generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DIRECTOR
  BOSS
  MANAGER
  STOREKEEPER
  EMPLOYEE
  ENGINEERING
  CHIEF_ACCOUNTANT
}

enum DepartmentType {
  OFFICE
  FACTORY
}

// Admin-managed singleton positions. Each value has at most one isActive
// holder at a time (old holder soft-ended via endedAt on reassignment) --
// this is how we resolve "who is currently the Chief Engineer / Finance
// Director / etc" without hardcoding a single user id anywhere.
enum ApprovalPosition {
  ENGINEERING_CHIEF
  OPERATIONS_DIRECTOR
  FINANCE_DIRECTOR
  EXECUTIVE_DIRECTOR
  STOREKEEPER_LEAD
  CHIEF_ACCOUNTANT_LEAD
  // Stage 7 responsibilities (both held by users with the MANAGER role).
  DOMESTIC_PROCUREMENT_MANAGER
  INTERNATIONAL_PROCUREMENT_MANAGER
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String
  role              UserRole  @default(EMPLOYEE)
  title             String?
  departmentId      String?
  isActive          Boolean   @default(true)
  // 1С OData хөтөч: цалингийн объектыг харах хүн тус бүрийн эрх (role-оос үл хамаарна, зөвхөн ADMIN өөрчилнө).
  canViewPayroll    Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?
  // Session revocation (Stage 2): a JWT carries the version it was issued under; any change of credentials bumps it
  // and every older token stops being accepted (lib/session-revocation.ts).
  sessionVersion    Int       @default(0)
  passwordChangedAt DateTime?

  department                 Department?                     @relation("DepartmentMembers", fields: [departmentId], references: [id])
  headOfDepartments          Department[]                    @relation("DepartmentHead")
  requestsCreated            MaterialRequest[]               @relation("RequestedBy")
  approvalActions            ApprovalAction[]
  approvalStepsAssigned      ApprovalStep[]                  @relation("ApprovalStepAssignee")
  approvalStepsDecided       ApprovalStep[]                  @relation("ApprovalStepDecider")
  warehouseChecks            WarehouseCheck[]
  stockIssues                StockIssue[]
  accountingRecords          AccountingRecord[]
  notifications              Notification[]
  auditLogs                  AuditLog[]
  approvalAssignments        ApprovalRoleAssignment[]
  attachments                Attachment[]
  approvalPinCredential      ApprovalPinCredential?
  procurementPurchases       ProcurementPurchase[]           @relation("PurchaseBy")
  procurementVoids           ProcurementPurchase[]           @relation("PurchaseVoidedBy")
  procurementAssignments     ProcurementItemAssignment[]     @relation("ProcurementAssignee")
  procurementClassifications ProcurementClassification[]     @relation("ClassificationConfirmedBy")
  recoveryTokens             PasswordRecoveryToken[]
  executiveDecisions         ExecutiveApprovalDecision[]     @relation("ExecutiveDecisionBy")
  deferredRequestsMade       DeferredApprovalRequest[]       @relation("DeferredRequestedBy")
  deferredRequestsDecided    DeferredApprovalRequest[]       @relation("DeferredDecidedBy")
  executiveReassignedFrom    ExecutiveApprovalReassignment[] @relation("ExecutiveReassignFrom")
  executiveReassignedTo      ExecutiveApprovalReassignment[] @relation("ExecutiveReassignTo")
  executiveReassignmentsMade ExecutiveApprovalReassignment[] @relation("ExecutiveReassignBy")
  foreignTradeOrders         ForeignTradeOrder[]             @relation("ForeignTradeCreator")
  foreignTradeSelections     ForeignTradeOrder[]             @relation("ForeignTradeSelector")
  foreignTradeQuotes         ForeignTradeQuote[]             @relation("ForeignTradeQuoteBy")
  foreignTradeMessages       ForeignTradeMessage[]           @relation("ForeignTradeMessageAuthor")
  foreignTradeDecisions      ForeignTradeDecision[]          @relation("ForeignTradeDecider")
  foreignTradeAttachments    ForeignTradeAttachment[]        @relation("ForeignTradeUploader")

  @@index([departmentId])
}

model ApprovalPinCredential {
  id             String    @id @default(cuid())
  userId         String    @unique
  pinHash        String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Department {
  id     String         @id @default(cuid())
  name   String
  type   DepartmentType
  headId String?

  head               User?               @relation("DepartmentHead", fields: [headId], references: [id])
  members            User[]              @relation("DepartmentMembers")
  requests           MaterialRequest[]
  foreignTradeOrders ForeignTradeOrder[]

  @@index([headId])
}

model ApprovalRoleAssignment {
  id        String           @id @default(cuid())
  role      ApprovalPosition
  userId    String
  isActive  Boolean          @default(true)
  startedAt DateTime         @default(now())
  endedAt   DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([role, isActive])
}

model Material {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  unit         String
  category     String?
  defaultPrice Decimal  @db.Decimal(14, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inventoryBalances InventoryBalance[]
  requestItems      MaterialRequestItem[]

  @@index([name])
}

model Warehouse {
  id       String  @id @default(cuid())
  name     String
  location String?

  inventoryBalances InventoryBalance[]
  reservations      StockReservation[]
}

model InventoryBalance {
  id               String   @id @default(cuid())
  materialId       String
  warehouseId      String
  quantityOnHand   Decimal  @db.Decimal(14, 3)
  quantityReserved Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt        DateTime @updatedAt

  material  Material  @relation(fields: [materialId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([materialId, warehouseId])
}

enum RequestStatus {
  DRAFT
  PENDING_DEPARTMENT_APPROVAL
  RETURNED_BY_DEPARTMENT
  PENDING_WAREHOUSE_CHECK
  PENDING_BRANCH_APPROVAL
  RETURNED_BY_BRANCH_APPROVER
  PENDING_MANAGER_PRICING
  RETURNED_BY_MANAGER_PRICING
  PENDING_FINANCE_APPROVAL
  RETURNED_BY_FINANCE
  PENDING_EXECUTIVE_APPROVAL
  RETURNED_BY_EXECUTIVE
  PENDING_PROCUREMENT
  PENDING_ACCOUNTING
  ACCOUNTING_COMPLETED
  PARTIALLY_COMPLETED
  COMPLETED
  CANCELLED
}

model MaterialRequest {
  id            String        @id @default(cuid())
  requestNumber String        @unique
  year          Int
  sequence      Int
  departmentId  String
  requestedById String
  status        RequestStatus @default(DRAFT)
  note          String?

  version      Int     @default(1)
  documentHash String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  submittedAt  DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  department                Department                      @relation(fields: [departmentId], references: [id])
  requestedBy               User                            @relation("RequestedBy", fields: [requestedById], references: [id])
  items                     MaterialRequestItem[]
  approvalSteps             ApprovalStep[]
  warehouseChecks           WarehouseCheck[]
  attachments               Attachment[]
  notifications             Notification[]
  accountingRecord          AccountingRecord?
  procurementClassification ProcurementClassification?
  executiveDecisions        ExecutiveApprovalDecision[]
  deferredApprovalRequests  DeferredApprovalRequest[]
  executiveReassignments    ExecutiveApprovalReassignment[]

  @@index([departmentId])
  @@index([requestedById])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
}

model MaterialRequestItem {
  id                        String   @id @default(cuid())
  requestId                 String
  lineNo                    Int
  materialId                String?
  manualMaterialName        String?
  unit                      String
  requestedQuantity         Decimal  @db.Decimal(14, 3)
  warehouseBalanceAtRequest Decimal? @db.Decimal(14, 3)
  unitPrice                 Decimal? @db.Decimal(14, 2)
  totalPrice                Decimal? @db.Decimal(14, 2)
  note                      String?

  request               MaterialRequest               @relation(fields: [requestId], references: [id], onDelete: Cascade)
  material              Material?                     @relation(fields: [materialId], references: [id])
  warehouseCheckItems   WarehouseCheckItem[]
  reservations          StockReservation[]
  purchases             ProcurementPurchase[]
  procurementAssignment ProcurementItemAssignment?
  executiveAllocations  ExecutiveApprovalAllocation[]
  deferredRequestItems  DeferredApprovalRequestItem[]

  @@unique([requestId, lineNo])
  @@index([materialId])
}

model WarehouseCheck {
  id          String   @id @default(cuid())
  requestId   String
  checkedById String
  checkedAt   DateTime @default(now())
  note        String?

  request   MaterialRequest      @relation(fields: [requestId], references: [id])
  checkedBy User                 @relation(fields: [checkedById], references: [id])
  items     WarehouseCheckItem[]

  @@index([requestId])
}

model WarehouseCheckItem {
  id                String  @id @default(cuid())
  warehouseCheckId  String
  requestItemId     String
  availableQuantity Decimal @db.Decimal(14, 3)
  allocatedQuantity Decimal @db.Decimal(14, 3)
  missingQuantity   Decimal @db.Decimal(14, 3)

  warehouseCheck WarehouseCheck      @relation(fields: [warehouseCheckId], references: [id], onDelete: Cascade)
  requestItem    MaterialRequestItem @relation(fields: [requestItemId], references: [id])

  @@unique([warehouseCheckId, requestItemId])
  // "latest warehouse check of an item" filters by requestItemId alone (procurement workload/monitoring)
  @@index([requestItemId])
}

enum ReservationStatus {
  RESERVED
  RELEASED
  ISSUED
}

model StockReservation {
  id            String            @id @default(cuid())
  requestItemId String
  warehouseId   String
  quantity      Decimal           @db.Decimal(14, 3)
  status        ReservationStatus @default(RESERVED)
  createdAt     DateTime          @default(now())
  releasedAt    DateTime?

  requestItem MaterialRequestItem @relation(fields: [requestItemId], references: [id])
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id])
  issue       StockIssue?

  @@index([requestItemId])
  @@index([warehouseId])
}

model StockIssue {
  id            String   @id @default(cuid())
  reservationId String   @unique
  issuedById    String
  quantity      Decimal  @db.Decimal(14, 3)
  issuedAt      DateTime @default(now())

  reservation StockReservation @relation(fields: [reservationId], references: [id])
  issuedBy    User             @relation(fields: [issuedById], references: [id])
}

enum ApprovalStepType {
  DEPARTMENT_HEAD
  WAREHOUSE_CHECK
  BRANCH_APPROVAL
  MANAGER_PRICING
  FINANCE_APPROVAL
  EXECUTIVE_APPROVAL
  MANAGER_PROCUREMENT
  ACCOUNTING_RECORD
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

model ApprovalStep {
  id             String             @id @default(cuid())
  requestId      String
  type           ApprovalStepType
  sequence       Int
  status         ApprovalStepStatus @default(PENDING)
  assignedUserId String?
  decidedById    String?
  decidedAt      DateTime?
  comment        String?

  request      MaterialRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  assignedUser User?            @relation("ApprovalStepAssignee", fields: [assignedUserId], references: [id])
  decidedBy    User?            @relation("ApprovalStepDecider", fields: [decidedById], references: [id])
  actions      ApprovalAction[]

  @@unique([requestId, sequence])
  @@index([assignedUserId, status])
}

enum ApprovalActionType {
  APPROVE
  REJECT
  RETURN
}

model ApprovalAction {
  id             String             @id @default(cuid())
  approvalStepId String
  actorId        String
  action         ApprovalActionType
  reason         String?
  documentHash   String?
  createdAt      DateTime           @default(now())

  approvalStep ApprovalStep @relation(fields: [approvalStepId], references: [id])
  actor        User         @relation(fields: [actorId], references: [id])

  @@index([approvalStepId])
  @@index([createdAt])
}

// Stage 7 (Manager procurement): one row per purchase of an outstanding
// request item. Append-only -- a mistake is corrected by voiding the row (it is
// kept, with who/when/why) and, for a changed quantity or price, recording a
// replacement that points back at it via `replacesId`. The purchased quantity
// of an item is the sum over its non-voided rows; "item is fully purchased" is
// derived from that against the warehouse shortfall, never stored as a flag.
// `clientRequestId` makes a retried submission idempotent.
model ProcurementPurchase {
  id              String    @id @default(cuid())
  requestItemId   String
  quantity        Decimal   @db.Decimal(14, 3)
  unitPrice       Decimal   @db.Decimal(14, 2)
  note            String?
  clientRequestId String?
  purchasedById   String
  purchasedAt     DateTime  @default(now())
  replacesId      String?   @unique
  voidedAt        DateTime?
  voidedById      String?
  voidReason      String?

  requestItem MaterialRequestItem  @relation(fields: [requestItemId], references: [id])
  purchasedBy User                 @relation("PurchaseBy", fields: [purchasedById], references: [id])
  voidedBy    User?                @relation("PurchaseVoidedBy", fields: [voidedById], references: [id])
  replaces    ProcurementPurchase? @relation("PurchaseCorrection", fields: [replacesId], references: [id])
  replacedBy  ProcurementPurchase? @relation("PurchaseCorrection")

  @@unique([requestItemId, clientRequestId])
  @@index([requestItemId, voidedAt])
  @@index([purchasedAt])
}

// Stage 7 coordination. When a request reaches procurement the International
// manager (ApprovalPosition INTERNATIONAL_PROCUREMENT_MANAGER) confirms, once,
// which of its outstanding items are bought abroad; every other outstanding item
// goes to the Domestic manager. `ProcurementClassification` records who confirmed
// and when (one per request); `ProcurementItemAssignment` is the per-item
// classification and its responsible manager. Items fully covered by the
// warehouse never get an assignment. Reassigning is a separate audited action
// (AuditLog PROCUREMENT_REASSIGN, with the reason) -- never a silent update.
enum ProcurementKind {
  DOMESTIC
  INTERNATIONAL
}

model ProcurementClassification {
  requestId     String   @id
  confirmedById String
  confirmedAt   DateTime @default(now())

  request     MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  confirmedBy User            @relation("ClassificationConfirmedBy", fields: [confirmedById], references: [id])
}

model ProcurementItemAssignment {
  requestItemId     String          @id
  kind              ProcurementKind
  assignedManagerId String
  assignedAt        DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  requestItem     MaterialRequestItem @relation(fields: [requestItemId], references: [id], onDelete: Cascade)
  assignedManager User                @relation("ProcurementAssignee", fields: [assignedManagerId], references: [id])

  @@index([assignedManagerId])
}

// Executive partial approval & deferred procurement.
//
// The executive director authorises purchasing in instalments. Every decision is
// an immutable event (a database trigger rejects UPDATE/DELETE on the decision
// and allocation tables); the authorised quantity of an item is the sum of its
// allocation deltas, and "deferred" is derived as required - authorised, never
// stored. MaterialRequestItem.requestedQuantity is never touched.
//
// A request approved before this feature existed has no decision rows; the
// application reads it as fully authorised (see lib/executive-approval.ts), so
// nothing has to be backfilled and no legacy request gains extra purchasing
// rights (the purchase cap is still the warehouse shortfall).
enum ExecutiveDecisionKind {
  INITIAL_FULL
  INITIAL_PARTIAL
  SUBSEQUENT
  DEFERRED_RETURN
}

enum DeferredApprovalStatus {
  PENDING
  APPROVED
  PARTIALLY_APPROVED
  RETURNED
}

model ExecutiveApprovalDecision {
  id                 String                @id @default(cuid())
  requestId          String
  // 1, 2, 3... per request; (requestId, sequence) is unique so concurrent decisions cannot collide.
  sequence           Int
  kind               ExecutiveDecisionKind
  decidedById        String
  decidedAt          DateTime              @default(now())
  comment            String?
  // Idempotency key supplied by the client; a retried submission is acknowledged, not applied twice.
  clientRequestId    String?
  // Procurement-officer request this decision resolved, if any.
  deferredRequestId  String?               @unique
  // Snapshot after this decision (sum over items with a purchase requirement).
  requiredTotal      Decimal               @db.Decimal(14, 3)
  approvedTotalAfter Decimal               @db.Decimal(14, 3)

  request         MaterialRequest               @relation(fields: [requestId], references: [id], onDelete: Cascade)
  decidedBy       User                          @relation("ExecutiveDecisionBy", fields: [decidedById], references: [id])
  deferredRequest DeferredApprovalRequest?      @relation("DeferredRequestResolution", fields: [deferredRequestId], references: [id], onDelete: NoAction)
  allocations     ExecutiveApprovalAllocation[]

  @@unique([requestId, sequence])
  @@unique([requestId, clientRequestId])
  @@index([decidedById])
}

// ADMIN-controlled transfer of a request's pending executive responsibility (the
// EXECUTIVE_APPROVAL step's assignee) from a replaced / deactivated executive to the
// current EXECUTIVE_DIRECTOR position holder. One immutable row per request moved;
// earlier decisions are never touched. See lib/executive-handover.ts.
model ExecutiveApprovalReassignment {
  id                  String   @id @default(cuid())
  // The client's idempotency key of the confirmed handover (shared by all rows of one handover).
  handoverKey         String
  requestId           String
  fromUserId          String
  toUserId            String
  reassignedById      String
  reason              String
  // As they were when the step was moved (read under the row lock).
  stepStatusBefore    String
  requestStatusBefore String
  createdAt           DateTime @default(now())

  request      MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromUser     User            @relation("ExecutiveReassignFrom", fields: [fromUserId], references: [id])
  toUser       User            @relation("ExecutiveReassignTo", fields: [toUserId], references: [id])
  reassignedBy User            @relation("ExecutiveReassignBy", fields: [reassignedById], references: [id])

  @@unique([handoverKey, requestId])
  @@index([requestId, createdAt])
}

model ExecutiveApprovalAllocation {
  id               String  @id @default(cuid())
  decisionId       String
  requestItemId    String
  // Quantity added by this decision (> 0).
  quantity         Decimal @db.Decimal(14, 3)
  // Snapshots, so history stays readable even if the warehouse shortfall is later re-checked.
  requiredQuantity Decimal @db.Decimal(14, 3)
  cumulativeAfter  Decimal @db.Decimal(14, 3)

  decision    ExecutiveApprovalDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  requestItem MaterialRequestItem       @relation(fields: [requestItemId], references: [id], onDelete: Cascade)

  @@unique([decisionId, requestItemId])
  @@index([requestItemId])
}

// A procurement officer's (MANAGER's) request for more authorised quantity. It
// carries no authority: only an executive decision turns it into allocations.
// A partial unique index (see the migration; Prisma cannot express it) allows
// one PENDING request per material request at a time.
model DeferredApprovalRequest {
  id              String                 @id @default(cuid())
  requestId       String
  status          DeferredApprovalStatus @default(PENDING)
  reason          String
  requestedById   String
  requestedAt     DateTime               @default(now())
  clientRequestId String?
  decidedById     String?
  decidedAt       DateTime?
  decisionComment String?

  request     MaterialRequest               @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestedBy User                          @relation("DeferredRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User?                         @relation("DeferredDecidedBy", fields: [decidedById], references: [id])
  items       DeferredApprovalRequestItem[]
  resolution  ExecutiveApprovalDecision?    @relation("DeferredRequestResolution")

  @@unique([requestId, clientRequestId])
  @@index([requestId, status])
}

model DeferredApprovalRequestItem {
  id                String   @id @default(cuid())
  deferredRequestId String
  requestItemId     String
  requestedQuantity Decimal  @db.Decimal(14, 3)
  // Set when the executive decides (0 = declined).
  approvedQuantity  Decimal? @db.Decimal(14, 3)

  deferredRequest DeferredApprovalRequest @relation(fields: [deferredRequestId], references: [id], onDelete: Cascade)
  requestItem     MaterialRequestItem     @relation(fields: [requestItemId], references: [id], onDelete: Cascade)

  @@unique([deferredRequestId, requestItemId])
  @@index([requestItemId])
}

// Stage 7 output -- Chief Accountant's financial record of a fully
// approved request. Terminal: this is a data-entry action, not an
// approve/reject decision, so it carries no ApprovalAction row.
model AccountingRecord {
  id           String   @id @default(cuid())
  requestId    String   @unique
  ledgerNumber String
  recordDate   DateTime
  note         String?
  recordedById String
  recordedAt   DateTime @default(now())

  request    MaterialRequest @relation(fields: [requestId], references: [id])
  recordedBy User            @relation(fields: [recordedById], references: [id])
}

model Attachment {
  id           String   @id @default(cuid())
  requestId    String
  fileName     String
  storageKey   String
  mimeType     String
  sizeBytes    Int
  uploadedById String
  uploadedAt   DateTime @default(now())

  request    MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploadedBy User            @relation(fields: [uploadedById], references: [id])

  @@index([requestId])
}

enum NotificationType {
  APPROVAL_REQUIRED
  REQUEST_RETURNED
  REQUEST_APPROVED
  WAREHOUSE_CHECK_NEEDED
  REQUEST_COMPLETED
  PROCUREMENT_REQUIRED
  GENERIC
  // Foreign trade: discussion messages and approval hand-offs are separate kinds on purpose.
  FOREIGN_TRADE_DISCUSSION
  FOREIGN_TRADE_APPROVAL
  FOREIGN_TRADE_UPDATE
}

model Notification {
  id                    String           @id @default(cuid())
  userId                String
  type                  NotificationType
  title                 String
  body                  String
  relatedRequestId      String?
  relatedForeignTradeId String?
  isRead                Boolean          @default(false)
  createdAt             DateTime         @default(now())

  user                User               @relation(fields: [userId], references: [id])
  relatedRequest      MaterialRequest?   @relation(fields: [relatedRequestId], references: [id])
  relatedForeignTrade ForeignTradeOrder? @relation(fields: [relatedForeignTradeId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([relatedForeignTradeId])
}

enum AuditAction {
  CREATE
  UPDATE
  SUBMIT
  APPROVE
  REJECT
  RETURN
  RESERVE_STOCK
  ISSUE_STOCK
  ACCOUNTING_RECORD
  CANCEL
  PIN_SETUP
  PIN_FAILURE
  PIN_LOCKOUT
  RESUBMIT
  CREATE_USER
  UPDATE_USER
  RESET_CREDENTIALS
  CHANGE_PASSWORD
  UPDATE_PRICE
  ATTACHMENT_UPLOAD
  VIEW_MONITORING
  MONITORING_ACCESS_DENIED
  PROCUREMENT_PURCHASE
  PROCUREMENT_VOID
  PROCUREMENT_COMPLETE
  PROCUREMENT_CLASSIFY
  PROCUREMENT_REASSIGN
  FT_QUOTE_ADD
  FT_QUOTE_UPDATE
  FT_QUOTE_DELETE
  FT_SHARE
  FT_SELECT_SUPPLIER
  FT_MESSAGE
  ONEC_ODATA_VIEW
  ONEC_ODATA_DENIED
  ONEC_PAYROLL_ACCESS
}

model AuditLog {
  id         String      @id @default(cuid())
  entityType String
  entityId   String
  action     AuditAction
  actorId    String
  beforeJson String?
  afterJson  String?
  createdAt  DateTime    @default(now())
  ipAddress  String?

  actor User @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  // Monitoring (/admin/monitoring): time-ordered activity feed, filtered feed,
  // and the per-request "last status transition" lookup.
  @@index([createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId, createdAt])
}

// Fixed-window attempt counters for credential checks (login and current-password
// verification), shared by every app instance through PostgreSQL. `key` is an opaque
// bucket name (see lib/login-throttle.ts): e-mail addresses and IPs are only ever stored
// hashed. Rows are written with single atomic upserts (raw SQL); they expire by
// themselves (a bucket whose window has passed counts as 0) and are purged by
// purgeStaleThrottles().
model LoginThrottle {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  updatedAt   DateTime

  @@index([windowStart])
}

// Self-service password recovery (Stage 4, disabled until a delivery channel is approved): a one-time token whose hash is
// stored; the clear token only ever travels to the account owner (e-mail), never through an administrator.
model PasswordRecoveryToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Foreign trade (Гадаад худалдаа). A workflow of its own: it shares User,
// Department, AuditLog, Notification, the PIN step-up and the object storage with
// the domestic procurement flow, but none of that flow's tables or statuses.
//
//   DRAFT --BOSS submits--> PENDING_MANAGER (price research, discussion, selection)
//         --MANAGER submits--> PENDING_TECHNICAL  (OR: operations director OR chief engineer)
//         --> PENDING_FINANCE (finance director) --> PENDING_EXECUTIVE (executive director)
//         --> APPROVED (handed to the finance department)
//   technical return -> RETURNED_TO_MANAGER;  finance / executive return -> RETURNED_TO_BOSS
//
// Decisions, messages and quotes are append-style history: decisions are never
// updated, and every action is also written to AuditLog (entityType
// "ForeignTradeOrder"). See lib/foreign-trade.ts.
// ---------------------------------------------------------------------------
enum ForeignTradeStatus {
  DRAFT
  PENDING_MANAGER
  PENDING_TECHNICAL
  RETURNED_TO_MANAGER
  PENDING_FINANCE
  PENDING_EXECUTIVE
  RETURNED_TO_BOSS
  APPROVED
}

enum ForeignTradeStage {
  TECHNICAL
  FINANCE
  EXECUTIVE
}

enum ForeignTradeDecisionAction {
  APPROVE
  RETURN
}

model ForeignTradeOrder {
  id                  String             @id @default(cuid())
  orderNumber         String             @unique
  year                Int
  sequence            Int
  createdById         String
  departmentId        String?
  status              ForeignTradeStatus @default(DRAFT)
  // Why the goods are needed (the BOSS's explanation of the need).
  purpose             String?
  // Optimistic-concurrency token: every state-changing action bumps it.
  version             Int                @default(1)
  // Counts submissions to technical review. A decision is unique per (order, cycle, stage), so two
  // simultaneous approvals of the same stage cannot both be recorded.
  cycle               Int                @default(0)
  // What the MANAGER has presented. Technical reviewers always see the order once it is submitted to them.
  sharedWithBoss      Boolean            @default(false)
  sharedWithTechnical Boolean            @default(false)
  // The final supplier, recorded by the MANAGER with the grounds for the decision.
  selectedQuoteId     String?            @unique
  selectionRationale  String?
  selectedById        String?
  selectedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  submittedAt         DateTime?
  approvedAt          DateTime?

  createdBy     User                     @relation("ForeignTradeCreator", fields: [createdById], references: [id])
  department    Department?              @relation(fields: [departmentId], references: [id])
  selectedBy    User?                    @relation("ForeignTradeSelector", fields: [selectedById], references: [id])
  selectedQuote ForeignTradeQuote?       @relation("ForeignTradeSelectedQuote", fields: [selectedQuoteId], references: [id], onDelete: SetNull)
  items         ForeignTradeItem[]
  quotes        ForeignTradeQuote[]      @relation("ForeignTradeQuotes")
  messages      ForeignTradeMessage[]
  decisions     ForeignTradeDecision[]
  attachments   ForeignTradeAttachment[]
  notifications Notification[]

  @@unique([year, sequence])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
}

model ForeignTradeItem {
  id       String  @id @default(cuid())
  orderId  String
  lineNo   Int
  name     String
  techSpec String?
  quantity Decimal @db.Decimal(14, 3)
  unit     String

  order ForeignTradeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, lineNo])
}

// One supplier's offer for the whole order (prices are for the full quantity, in the supplier's own currency; no
// exchange rate is applied anywhere, so quotes in different currencies are shown side by side, never summed).
model ForeignTradeQuote {
  id           String   @id @default(cuid())
  orderId      String
  supplierName String
  country      String
  currency     String
  price        Decimal  @db.Decimal(16, 2)
  shippingCost Decimal  @default(0) @db.Decimal(16, 2)
  leadTimeDays Int?
  warranty     String?
  note         String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  order       ForeignTradeOrder        @relation("ForeignTradeQuotes", fields: [orderId], references: [id], onDelete: Cascade)
  createdBy   User                     @relation("ForeignTradeQuoteBy", fields: [createdById], references: [id])
  selectedFor ForeignTradeOrder?       @relation("ForeignTradeSelectedQuote")
  messages    ForeignTradeMessage[]
  attachments ForeignTradeAttachment[]

  @@index([orderId])
}

model ForeignTradeMessage {
  id        String   @id @default(cuid())
  orderId   String
  authorId  String
  body      String
  // Optional: the supplier offer this message is about.
  quoteId   String?
  createdAt DateTime @default(now())

  order       ForeignTradeOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author      User                     @relation("ForeignTradeMessageAuthor", fields: [authorId], references: [id])
  quote       ForeignTradeQuote?       @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  attachments ForeignTradeAttachment[]

  @@index([orderId, createdAt])
}

model ForeignTradeDecision {
  id              String                     @id @default(cuid())
  orderId         String
  cycle           Int
  stage           ForeignTradeStage
  action          ForeignTradeDecisionAction
  decidedById     String
  // Required for a return.
  reason          String?
  // The supplier offer that was selected when the decision was taken (history, not a live reference).
  selectedQuoteId String?
  createdAt       DateTime                   @default(now())

  order     ForeignTradeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  decidedBy User              @relation("ForeignTradeDecider", fields: [decidedById], references: [id])

  @@unique([orderId, cycle, stage])
  @@index([decidedById])
}

model ForeignTradeAttachment {
  id           String   @id @default(cuid())
  orderId      String
  quoteId      String?
  messageId    String?
  fileName     String
  storageKey   String
  mimeType     String
  sizeBytes    Int
  uploadedById String
  uploadedAt   DateTime @default(now())

  order      ForeignTradeOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quote      ForeignTradeQuote?   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  message    ForeignTradeMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadedBy User                 @relation("ForeignTradeUploader", fields: [uploadedById], references: [id])

  @@index([orderId])
}

// =====================================================================
// 1С ERP-ээс татсан өгөгдөл (lib/onec/*). Хүснэгт бүр сар/өдрөөр нь бүхэлд нь солигддог.
// =====================================================================

model OnecSales {
  id         BigInt   @id @default(autoincrement())
  date       DateTime @db.Date
  org        String   @default("")
  itemCode   String   @default("") @map("item_code")
  item       String   @default("")
  unit       String   @default("")
  qty        Decimal  @default(0) @db.Decimal(18, 4)
  amount     Decimal  @default(0) @db.Decimal(18, 2)
  vat        Decimal  @default(0) @db.Decimal(18, 2)
  cost       Decimal  @default(0) @db.Decimal(18, 2)
  clientCode String   @default("") @map("client_code")
  client     String   @default("")
  clientReg  String   @default("") @map("client_reg")
  dept       String   @default("")
  doc        String   @default("")
  rowType    String   @default("") @map("row_type")
  syncedAt   DateTime @default(now()) @map("synced_at") @db.Timestamptz

  @@index([date])
  @@index([itemCode, date])
  @@index([clientCode, date])
  @@map("onec_sales")
}

model OnecPl {
  id           BigInt   @id @default(autoincrement())
  month        String   @db.Char(7)
  itemCode     String   @default("") @map("item_code")
  item         String   @default("")
  account      String   @default("")
  accountGroup String   @default("") @map("account_group")
  side         String   @default("")
  amount       Decimal  @default(0) @db.Decimal(18, 2)
  syncedAt     DateTime @default(now()) @map("synced_at") @db.Timestamptz

  @@index([month, accountGroup])
  @@map("onec_pl")
}

model OnecStock {
  id            BigInt   @id @default(autoincrement())
  snapshotDate  DateTime @map("snapshot_date") @db.Date
  org           String   @default("")
  warehouseCode String   @default("") @map("warehouse_code")
  warehouse     String   @default("")
  itemCode      String   @default("") @map("item_code")
  item          String   @default("")
  unit          String   @default("")
  account       String   @default("")
  qty           Decimal  @default(0) @db.Decimal(18, 4)
  amount        Decimal  @default(0) @db.Decimal(18, 2)
  syncedAt      DateTime @default(now()) @map("synced_at") @db.Timestamptz

  @@index([snapshotDate, warehouseCode])
  @@index([itemCode, snapshotDate])
  @@map("onec_stock")
}

model OnecCash {
  id         BigInt   @id @default(autoincrement())
  date       DateTime @db.Date
  account    String   @default("")
  clientCode String   @default("") @map("client_code")
  client     String   @default("")
  itemCode   String   @default("") @map("item_code")
  item       String   @default("")
  inflow     Decimal  @default(0) @db.Decimal(18, 2)
  outflow    Decimal  @default(0) @db.Decimal(18, 2)
  memo       String   @default("")
  doc        String   @default("")
  syncedAt   DateTime @default(now()) @map("synced_at") @db.Timestamptz

  @@index([date])
  @@index([account, date])
  @@map("onec_cash")
}

// Авлага (/hs/dash/receivables?asof=): stock-той адил өдрийн агшин зургаар хадгална
model OnecReceivable {
  id           BigInt   @id @default(autoincrement())
  snapshotDate DateTime @map("snapshot_date") @db.Date
  type         String   @default("")
  clientCode   String   @default("") @map("client_code")
  client       String   @default("")
  doc          String   @default("")
  docDate      String   @default("") @map("doc_date")
  due          String   @default("")
  amount       Decimal  @default(0) @db.Decimal(18, 2)
  balance      Decimal  @default(0) @db.Decimal(18, 2)
  overdueDays  Int      @default(0) @map("overdue_days")
  syncedAt     DateTime @default(now()) @map("synced_at") @db.Timestamptz

  @@index([snapshotDate, clientCode])
  @@map("onec_receivables")
}

// 1С-ээс татах ажлыг нэг зэрэг ганцхан instance/хүсэлт гүйцэтгэх түрээс (lease). Хугацаа нь DB-ийн цагаар дуусдаг тул
// процесс үхсэн ч хаалт өөрөө суллагдана (lib/onec/refresh.ts).
model OnecSyncLock {
  name        String   @id
  holder      String
  lockedUntil DateTime @map("locked_until") @db.Timestamptz

  @@map("onec_sync_lock")
}

// «Авлага» табын агшин зураг (lib/onec/receivables-store.ts, raw SQL-ээр ашиглана). 1201: харилцагч бүрээр; НӨАТ-ын данс: нэг мөр.
model OnecReceivableBalance {
  id           BigInt   @id @default(autoincrement())
  snapshotDate DateTime @map("snapshot_date") @db.Date
  accountCode  String   @map("account_code")
  accountName  String   @default("") @map("account_name")
  customerKey  String   @default("") @map("customer_key")
  customer     String   @default("")
  balance      Decimal  @db.Decimal(18, 2)
  customers    Int      @default(1)
  syncedAt     DateTime @default(now()) @map("synced_at") @db.Timestamptz

  @@index([snapshotDate, accountCode])
  @@map("onec_receivable_balances")
}

model OnecSyncLog {
  id         BigInt   @id @default(autoincrement())
  kind       String
  period     String
  rows       Int      @default(0)
  ok         Boolean
  message    String?
  startedAt  DateTime @map("started_at") @db.Timestamptz
  finishedAt DateTime @default(now()) @map("finished_at") @db.Timestamptz

  @@index([kind, finishedAt(sort: Desc)])
  @@map("onec_sync_log")
}
