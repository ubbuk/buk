{
  "name": "ub-buk-procurement",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:wasm": "bash native/timeline-engine/build.sh",
    "check:lockfile": "npx -y npm@10 ci --ignore-scripts --dry-run",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:prod": "tsx prisma/seed.production.ts",
    "db:seed:warehouses": "tsx prisma/seed.warehouses.ts",
    "test": "vitest run",
    "sync:1c": "tsx --env-file-if-exists=.env scripts/sync-1c.ts",
    "onec:objects": "tsx --env-file=.env scripts/onec-odata-objects.ts",
    "onec:labels-doc": "tsx scripts/gen-onec-labels-doc.ts",
    "onec:product-check": "tsx --env-file=.env scripts/onec-product-check.ts",
    "onec:cash-accounts-check": "tsx --env-file=.env scripts/onec-cash-accounts-check.ts",
    "onec:cash-check": "tsx --env-file=.env scripts/onec-cash-check.ts",
    "onec:reconcile": "tsx --env-file=.env scripts/onec-reconcile.ts",
    "onec:warehouse-mapping": "tsx --env-file=.env scripts/onec-warehouse-mapping.ts",
    "cleanup:test-orders": "tsx --env-file-if-exists=.env scripts/cleanup-test-orders.ts",
    "check:multi-warehouse": "tsx --env-file=.env scripts/check-multi-warehouse-balances.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@prisma/client": "^6.1.0",
    "@react-pdf/renderer": "^4.1.6",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@types/bcrypt": "^6.0.0",
    "@types/three": "^0.187.0",
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "gsap": "^3.15.0",
    "heic2any": "^0.0.4",
    "lucide-react": "^0.468.0",
    "next": "^15.1.3",
    "next-auth": "^4.24.11",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.187.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
